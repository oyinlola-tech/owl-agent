{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "VITE_OWL_WEBSITE_ONLY=1 npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/download/windows",
      "destination": "https://github.com/oyinlola-tech/owl-agent/releases/latest/download/OWL-Agent-Setup-x64.exe",
      "statusCode": 302
    },
    {
      "source": "/download/windows-msi",
      "destination": "https://github.com/oyinlola-tech/owl-agent/releases/latest/download/OWL-Agent-x64.msi",
      "statusCode": 302
    },
    {
      "source": "/download/mac",
      "destination": "https://github.com/oyinlola-tech/owl-agent/releases/latest/download/OWL-Agent-macOS-AppleSilicon.dmg",
      "statusCode": 302
    },
    {
      "source": "/download/mac-intel",
      "destination": "https://github.com/oyinlola-tech/owl-agent/releases/latest/download/OWL-Agent-macOS-Intel.dmg",
      "statusCode": 302
    },
    {
      "source": "/download/linux",
      "destination": "https://github.com/oyinlola-tech/owl-agent/releases/latest/download/OWL-Agent-Linux-x64.AppImage",
      "statusCode": 302
    },
    {
      "source": "/download/linux-deb",
      "destination": "https://github.com/oyinlola-tech/owl-agent/releases/latest/download/OWL-Agent-Linux-x64.deb",
      "statusCode": 302
    },
    {
      "source": "/download/linux-rpm",
      "destination": "https://github.com/oyinlola-tech/owl-agent/releases/latest/download/OWL-Agent-Linux-x64.rpm",
      "statusCode": 302
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-RQNhPE++XBtrW3Xy4Flei5LR1/DeOgZ5r0kikFgz90Q='; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.github.com; frame-src owl:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
