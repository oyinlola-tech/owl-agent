# Copy to .env and fill in. Placeholders only — never commit real keys.
OWL_HOST=127.0.0.1
OWL_PORT=8000
OWL_LOG_LEVEL=info
# Comma-separated extra origins. The desktop dev origin is always allowed.
OWL_TRUSTED_ORIGINS=
OWL_MAX_BODY_BYTES=262144
OWL_STEP_DELAY=1.0
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_TIMEOUT=60.0
NVIDIA_MAX_TOKENS=1024
NVIDIA_TEMPERATURE=0.7
# SQLite path override; empty uses the app data dir.
OWL_DB_PATH=
# App data directory override; empty uses the platform default.
OWL_DATA_DIR=
# Default provider id; empty auto-selects the first configured provider.
OWL_PROVIDER=
OWL_ROUTER_DEFAULT_MODEL=
OWL_ROUTER_FALLBACK_MODEL=
OWL_ROUTER_ALLOW_FALLBACK=true
OWL_CONTEXT_BUDGET=0.8
OWL_CONTEXT_RESERVE=0.25
OWL_MAX_RETRIES=2
OWL_MEMORY_RETENTION=200
OWL_WORKSPACES=
OWL_EXEC_TIMEOUT=120.0
OWL_EXEC_OUTPUT_LIMIT=65536
OWL_APPROVAL_TTL=1800.0
OWL_MAX_ITERATIONS=25
OWL_MAX_MODEL_CALLS=40
OWL_MAX_ELAPSED=1800.0
# Bearer token required by the desktop app for service auth.
OWL_SERVICE_TOKEN=
# Dev-only token accepted when token auth is required.
OWL_DEV_TOKEN=
# Path to the file holding the service token.
OWL_SERVICE_TOKEN_FILE=
# Require a bearer token on state-changing requests.
OWL_REQUIRE_TOKEN=
# Comma-separated extra allowed hosts for the service.
OWL_ALLOWED_HOSTS=
# Sandbox mode for commands: preferred, always, or never.
OWL_SANDBOX=
# Allow network access during verification runs.
OWL_VERIFY_NETWORK=
# Allow the browser tool to reach loopback addresses.
OWL_BROWSER_ALLOW_LOOPBACK=
